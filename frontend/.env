# ─── API Base URL ────────────────────────────────────────────────────────────
# LOCAL DEV: Points directly to the Cloudflare tunnel (update when tunnel restarts)
# PRODUCTION (Netlify): Leave this blank or set to /api/v1 — Netlify's proxy
#   redirect in netlify.toml forwards /api/* to the tunnel automatically.
#   This avoids cross-site cookie issues since browser sees same origin.
# ─────────────────────────────────────────────────────────────────────────────

# For local dev with Cloudflare tunnel (update tunnel URL when it restarts):
# VITE_API_BASE_URL=https://emacs-hair-deals-chapter.trycloudflare.com/api/v1

# For Netlify production — uses the proxy in netlify.toml (same origin, no CORS):
VITE_API_BASE_URL=https://dentists-fine-scanner-asbestos.trycloudflare.com/api/v1
